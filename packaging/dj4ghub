#!/bin/sh
set -u

SOURCE=$0
while [ -L "${SOURCE}" ]; do
  SOURCE_DIR=$(CDPATH= cd -P -- "$(dirname -- "${SOURCE}")" && pwd)
  SOURCE=$(readlink "${SOURCE}")
  case "${SOURCE}" in
    /*) ;;
    *) SOURCE="${SOURCE_DIR}/${SOURCE}" ;;
  esac
done
ROOT_DIR=$(CDPATH= cd -P -- "$(dirname -- "${SOURCE}")" && pwd)
BINARY="${ROOT_DIR}/bin/dj4ghub-macos"
URL="http://127.0.0.1:7575"
DATA_DIR="${HOME}/Library/Application Support/DJ 4G Hub"
LOG_DIR="${HOME}/Library/Logs/DJ 4G Hub"
PID_FILE="${DATA_DIR}/dj4ghub.pid"
LOG_FILE="${LOG_DIR}/dj4ghub.log"

usage() {
  cat <<'EOF'
DJ 4G Hub for macOS

用法：
  dj4ghub start          启动并自动打开管理网页
  dj4ghub start --demo   启动无硬件演示模式
  dj4ghub activate       清理模块残留网卡并一次性激活上网模式
  dj4ghub stop           停止正在运行的程序
  dj4ghub status         查看运行状态
  dj4ghub logs           查看实时日志（Ctrl+C 退出日志）
  dj4ghub open           打开管理网页
EOF
}

read_pid() {
  if [ -f "${PID_FILE}" ]; then
    tr -cd '0-9' <"${PID_FILE}"
  fi
}

is_running() {
  pid=$(read_pid)
  [ -n "${pid}" ] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  command_line=$(ps -p "${pid}" -o command= 2>/dev/null || true)
  case "${command_line}" in
    */bin/dj4ghub-macos*) return 0 ;;
    *) return 1 ;;
  esac
}

clean_stale_pid() {
  if [ -f "${PID_FILE}" ] && ! is_running; then
    rm -f "${PID_FILE}"
  fi
}

open_page() {
  if [ "${DJ4GHUB_NO_OPEN:-0}" = "1" ]; then
    return 0
  fi
  open "${URL}" >/dev/null 2>&1 || {
    printf '请在浏览器中打开：%s\n' "${URL}"
  }
}

start_service() {
  mode=${1:-}
  if [ ! -x "${BINARY}" ]; then
    printf '启动失败：缺少可执行文件 %s\n' "${BINARY}" >&2
    exit 1
  fi
  if [ "$(uname -m)" != "arm64" ]; then
    printf '当前发行包仅支持 Apple Silicon（M 系列芯片）。\n' >&2
    exit 1
  fi

  mkdir -p "${DATA_DIR}" "${LOG_DIR}"
  if [ -f "${LOG_FILE}" ] && [ "$(wc -c <"${LOG_FILE}")" -gt 5242880 ]; then
    mv -f "${LOG_FILE}" "${LOG_FILE}.1"
  fi
  clean_stale_pid
  if is_running; then
    printf 'DJ 4G Hub 已在运行，正在打开管理网页。\n'
    open_page
    exit 0
  fi

  if /usr/sbin/lsof -nP -iTCP:7575 -sTCP:LISTEN >/dev/null 2>&1; then
    printf '启动失败：端口 7575 已被其他程序占用。\n' >&2
    exit 1
  fi

  if [ "${mode}" = "--demo" ]; then
    "${BINARY}" -listen 127.0.0.1:7575 -demo >>"${LOG_FILE}" 2>&1 &
  else
    "${BINARY}" -listen 127.0.0.1:7575 >>"${LOG_FILE}" 2>&1 &
  fi
  child=$!
  printf '%s\n' "${child}" >"${PID_FILE}"

  stopping=0
  stop_child() {
    if [ "${stopping}" -eq 0 ]; then
      stopping=1
      printf '\n正在停止 DJ 4G Hub...\n'
      kill -TERM "${child}" 2>/dev/null || true
    fi
  }
  trap stop_child INT TERM HUP
  trap 'rm -f "${PID_FILE}"' EXIT

  ready=0
  attempts=0
  while [ "${attempts}" -lt 50 ]; do
    if ! kill -0 "${child}" 2>/dev/null; then
      break
    fi
    if /usr/bin/curl -fsS --max-time 1 "${URL}/" >/dev/null 2>&1; then
      ready=1
      break
    fi
    attempts=$((attempts + 1))
    sleep 0.2
  done

  if [ "${ready}" -eq 1 ]; then
    printf 'DJ 4G Hub 已启动：%s\n' "${URL}"
    printf '日志文件：%s\n' "${LOG_FILE}"
    printf '按 Ctrl+C 即可停止。\n'
    open_page
  else
    printf 'DJ 4G Hub 未能正常启动，请查看日志：%s\n' "${LOG_FILE}" >&2
  fi

  wait "${child}"
  status=$?
  trap - INT TERM HUP
  if [ "${stopping}" -eq 0 ] && [ "${status}" -ne 0 ]; then
    printf 'DJ 4G Hub 异常退出（状态码 %s），请查看日志：%s\n' "${status}" "${LOG_FILE}" >&2
  else
    printf 'DJ 4G Hub 已停止。\n'
  fi
  exit "${status}"
}

stop_service() {
  clean_stale_pid
  if ! is_running; then
    printf 'DJ 4G Hub 当前没有运行。\n'
    exit 0
  fi
  pid=$(read_pid)
  kill -TERM "${pid}" 2>/dev/null || true
  attempts=0
  while kill -0 "${pid}" 2>/dev/null && [ "${attempts}" -lt 50 ]; do
    attempts=$((attempts + 1))
    sleep 0.1
  done
  if kill -0 "${pid}" 2>/dev/null; then
    printf 'DJ 4G Hub 尚未退出，请回到启动它的终端按 Ctrl+C。\n' >&2
    exit 1
  fi
  rm -f "${PID_FILE}"
  printf 'DJ 4G Hub 已停止。\n'
}

show_status() {
  clean_stale_pid
  if is_running; then
    printf 'DJ 4G Hub 正在运行（PID %s）\n' "$(read_pid)"
    printf '管理网页：%s\n' "${URL}"
  else
    printf 'DJ 4G Hub 当前没有运行。\n'
  fi
}

activate_network() {
  if [ ! -x "${BINARY}" ]; then
    printf '激活失败：缺少可执行文件 %s\n' "${BINARY}" >&2
    exit 1
  fi
  clean_stale_pid
  if is_running || /usr/sbin/lsof -nP -iTCP:7575 -sTCP:LISTEN >/dev/null 2>&1; then
    printf '激活前请先执行 dj4ghub stop，释放模块 USB AT 接口。\n' >&2
    exit 1
  fi
  exec "${BINARY}" -activate
}

case "${1:-}" in
  start)
    case "${2:-}" in
      ""|--demo) start_service "${2:-}" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  activate) activate_network ;;
  stop) stop_service ;;
  status) show_status ;;
  logs)
    mkdir -p "${LOG_DIR}"
    touch "${LOG_FILE}"
    tail -n 100 -f "${LOG_FILE}"
    ;;
  open) open_page ;;
  help|-h|--help|"") usage ;;
  *) usage; exit 2 ;;
esac
